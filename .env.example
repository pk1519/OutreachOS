# ==============================================================================
# DUO SYSTEMS — LEAD FINDER & OUTREACH CENTER
# Environment Variables Configuration Template
# ==============================================================================

# Database Connection (PostgreSQL for Production, SQLite for local dev)
# Example: postgresql://duo_admin:duo_secure_password_2026@localhost:5432/duo_leads
DATABASE_URL=sqlite:///./duo_leads.db

# Google Places API (New) Key
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Restrict to "Places API (New)"
GOOGLE_PLACES_API_KEY=

# Google OAuth 2.0 Credentials (for Gmail API & Google Sheets)
# Obtain from Google Cloud Console > Credentials > OAuth Client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback

# Gmail Outreach Settings
GMAIL_SENDER_EMAIL=contact.devworks7@gmail.com
GOOGLE_SHEETS_ENABLED=true

# Application Environment & Security
APP_ENV=development
SECRET_KEY=generate_a_random_32_byte_secret_key_here
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# Cost & Safety Ceilings
MAX_AREAS_PER_SEARCH=15
MAX_RESULTS_PER_SEARCH=100
ENABLE_DEMO_SIMULATION=true
